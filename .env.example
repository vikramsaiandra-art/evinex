# ============================================================
# EVINEX ENVIRONMENT VARIABLES — copy to `.env` (NEVER commit it)
# ============================================================

# NODE_ENV: set to "production" on deployed hosts so the Express
# server serves the built SPA from dist/ instead of Vite dev HMR.
NODE_ENV=""

# PORT: listen port (default 3000; platforms like Render/Railway
# inject their own value automatically).
PORT=""

# EVINEX_DB_PATH (optional): SQLite database file location.
# Defaults to ./data/evinex.db. In production point this at a
# persistent volume so the database survives redeploys, e.g.
#   Render disk:   /var/data/evinex.db
#   Docker volume: /app/data/evinex.db
# Demo accounts can be (re)ensured in any database via `npm run seed`.
EVINEX_DB_PATH=""

# ALLOWED_ORIGIN (backend, optional): the CORS origin permitted to
# call the API when the SPA is hosted on a DIFFERENT domain, e.g.
#   ALLOWED_ORIGIN=https://evinex.netlify.app
# Unset or "*" = allow any origin (fine for demos; lock down in prod).
# Bearer-token auth is used (no cookies), so cross-origin is safe.
ALLOWED_ORIGIN=""

# VITE_API_BASE (frontend, BUILD-TIME ONLY): full URL of the backend
# when the SPA is deployed separately (Netlify / GitHub Pages), e.g.
#   VITE_API_BASE=https://evinex-backend.onrender.com
# Vite inlines this at BUILD time — set it in the hosting dashboard
# BEFORE the build and redeploy after changing it.
# Leave empty for full-stack deploys where Express serves the SPA
# itself (relative /api calls are then correct).
VITE_API_BASE=""

# GOOGLE_CLIENT_ID (optional): Google OAuth 2.0 Web Client ID for Gmail
# "Sign in with Google" on the login page. When unset, the Google button
# runs in demo mode (email prompt) and creates USER accounts locally.
# Admin Portal sign-in does NOT use Google - it is password-only.
GOOGLE_CLIENT_ID=""

# GEMINI_API_KEY: Required for Gemini AI API calls (currently unused
# by the app; kept for AI Studio compatibility).
GEMINI_API_KEY=""
